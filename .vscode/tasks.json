{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Start LoadGuard AI (Full Stack)",
      "type": "shell",
      "command": "./start.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run Pytest Test Suite",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/bin/pytest test_backend.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
